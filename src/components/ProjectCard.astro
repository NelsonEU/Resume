---
import type { Project } from '../data/site';

interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<a class="project reveal" href={project.href} target="_blank">
  <div class="p-head mono small">
    <span class="muted">{project.dir}</span>
    {
      project.liveStatus && (
        <span class="p-live" data-pi data-pi-live hidden>
          <span class="dot" aria-hidden="true" />
          <span data-pi-state />
        </span>
      )
    }
  </div>
  <h3 class="p-title">{project.title} {project.wip && <span class="badge mono">wip</span>}</h3>
  <span class="p-text">{project.text}</span>
  {
    project.liveStatus && (
      <span class="p-meta mono small muted" data-pi hidden>
        players <span class="ink" data-pi-players /> · mood <span class="ink" data-pi-mood />
      </span>
    )
  }
</a>
