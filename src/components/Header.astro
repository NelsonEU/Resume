---
import { profile } from '../data/site';

const nav = ['writing', 'projects', 'now', 'cv', 'contact'];
---

<header class="top mono">
  <a href="/"><span class="acc">~/</span>arn0.be</a>
  <nav class="nav">
    {nav.map((id) => <a href={`#${id}`}>{id}</a>)}
  </nav>
  <div class="top-right">
    <a href={profile.cv} target="_blank" class="cv-mobile acc">cv.pdf ↓</a>
    <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch to light mode">
      <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"
        ><circle cx="12" cy="12" r="4"></circle><path
          d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
        ></path></svg
      >
      <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"
        ><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg
      >
    </button>
  </div>
</header>
